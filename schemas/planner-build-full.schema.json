{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/azadix/medianxl-db/schemas/planner-build-full.schema.json",
  "title": "TSW planner build export",
  "$comment": "NotArmory/TSW character export envelope. Native planner saves are a different JSON shape and are not this schema. Import unwraps build and maps catalog-backed items.",
  "type": "object",
  "additionalProperties": true,
  "required": ["build", "items"],
  "properties": {
    "ok": { "type": "boolean" },
    "api_version": { "type": "integer", "minimum": 1 },
    "meta": {
      "type": "object",
      "additionalProperties": true
    },
    "build": { "$ref": "#/$defs/TswBuild" },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/TswItem" },
      "$comment": "Flat NotArmory dump. Gear uses location Gear + slot; charms/relics use Inventory."
    }
  },
  "$defs": {
    "QuestDifficulties": {
      "type": "object",
      "additionalProperties": false,
      "required": ["normal", "nightmare", "hell"],
      "properties": {
        "normal": { "type": "boolean" },
        "nightmare": { "type": "boolean" },
        "hell": { "type": "boolean" }
      }
    },
    "SkillPointsMap": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    },
    "TswBuild": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name", "class", "level", "skillPoints", "oSkills"],
      "properties": {
        "name": { "type": "string", "$comment": "Character / build name." },
        "class": { "type": "string", "minLength": 1 },
        "level": { "type": "integer", "minimum": 1, "maximum": 150 },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "skillPoints": {
          "$ref": "#/$defs/SkillPointsMap",
          "$comment": "Hard points per tree skill. Keys are display names."
        },
        "oSkills": {
          "$ref": "#/$defs/SkillPointsMap",
          "$comment": "Character-sheet oSkill totals (item grants included)."
        },
        "allSkillsBonus": { "type": "integer", "minimum": 0 },
        "classSkillsBonus": { "type": "integer", "minimum": 0 },
        "stats": {
          "type": "string",
          "$comment": "Planner stats template blob, e.g. {{life}}=12338."
        },
        "questsCompleted": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/QuestDifficulties" },
          "properties": {
            "den_of_evil": { "$ref": "#/$defs/QuestDifficulties" },
            "radament": { "$ref": "#/$defs/QuestDifficulties" },
            "izual": { "$ref": "#/$defs/QuestDifficulties" },
            "lam_essen's_tome": { "$ref": "#/$defs/QuestDifficulties" },
            "golden_bird": { "$ref": "#/$defs/QuestDifficulties" },
            "inquisitor_of_the_triune": { "$ref": "#/$defs/QuestDifficulties" },
            "justicar_signet": { "$ref": "#/$defs/QuestDifficulties" }
          }
        },
        "savedAt": { "type": "string" }
      }
    },
    "DescriptionSegment": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        { "type": "string", "$comment": "Tooltip fragment." },
        { "type": "integer", "$comment": "NotArmory colour id." }
      ],
      "items": false
    },
    "DescriptionLine": {
      "type": "array",
      "items": { "$ref": "#/$defs/DescriptionSegment" }
    },
    "DescriptionLines": {
      "type": "array",
      "items": { "$ref": "#/$defs/DescriptionLine" }
    },
    "MysticOrbs": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "prefixItems": [
          { "type": "integer", "minimum": 1 },
          { "type": "string", "minLength": 1 }
        ],
        "items": false
      }
    },
    "RangeBag": {
      "type": ["object", "array"],
      "$comment": "NotArmory sometimes emits {} maps and sometimes []."
    },
    "Socketable": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "name"],
      "properties": {
        "type": { "type": "string" },
        "name": { "type": "string" },
        "quality": { "type": "string" },
        "name_color": { "type": "integer" },
        "code": { "type": "string" },
        "image": { "type": "string" },
        "slot": { "type": "integer" },
        "description_lines": { "$ref": "#/$defs/DescriptionLines" }
      }
    },
    "TswItem": {
      "type": "object",
      "additionalProperties": true,
      "required": ["item", "location"],
      "properties": {
        "item": { "type": "string", "minLength": 1 },
        "display_name": { "type": "string" },
        "type": { "type": "string" },
        "quality": { "type": "string" },
        "display_quality": { "type": "string" },
        "code": { "type": "string" },
        "image": { "type": "string" },
        "name_color": { "type": "integer" },
        "eth": { "type": "boolean" },
        "corrupted": { "type": "boolean" },
        "is_charm": { "type": "boolean" },
        "is_trophy": { "type": "boolean" },
        "is_class_charm": { "type": "boolean" },
        "is_rw": { "type": "boolean" },
        "is_upgraded": { "type": "boolean" },
        "has_trophy": { "type": "boolean" },
        "area": { "type": "string" },
        "location": { "type": "string", "minLength": 1 },
        "slot": { "type": ["string", "null"] },
        "description_lines": { "$ref": "#/$defs/DescriptionLines" },
        "socketables": {
          "type": "array",
          "items": { "$ref": "#/$defs/Socketable" }
        },
        "mystic_orbs": { "$ref": "#/$defs/MysticOrbs" },
        "stat_ranges": { "$ref": "#/$defs/RangeBag" },
        "charm_ranges": { "$ref": "#/$defs/RangeBag" }
      }
    }
  }
}
